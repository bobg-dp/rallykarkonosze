[Unit]
Description=AMG Rally Karkonosze backend
After=network.target

[Service]
Type=simple
User=rally
Group=rally
WorkingDirectory=/var/www/rallykarkonosze
Environment=NODE_ENV=production
EnvironmentFile=/etc/rallykarkonosze/backend.env
ExecStart=/usr/bin/npm run start:backend
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target